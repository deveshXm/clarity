{
  "name": "answerable",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:test": "bash scripts/dev-test.sh",
    "digest:test": "tsx --env-file=.env.local src/scripts/test-style-digest.ts",
    "digest:me": "tsx --env-file=.env.local src/scripts/digest-me.ts",
    "digest:sample": "tsx --env-file=.env.local src/scripts/style-digest-20-msg.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "evals:style": "tsx --env-file=.env.local src/evals/langwatch/style-deviation.experiment.ts",
    "trigger:dev": "npx trigger.dev@4.3.2 dev --env-file .env.local",
    "trigger:deploy": "npx trigger.dev@4.3.2 deploy --env prod --env-file .env.production",
    "evals:setup": "bash evals/setup.sh",
    "evals:generate": "cd evals && poetry run python generate.py --step all",
    "evals:generate:flags": "cd evals && poetry run python generate.py --step flags",
    "evals:generate:messages": "cd evals && poetry run python generate.py --step messages",
    "evals:generate:default": "cd evals && poetry run python generate_default.py",
    "evals:run": "cd evals && poetry run python evaluate.py",
    "evals:run:prod": "cd evals && BASE_URL=https://clarity.rocktangle.com poetry run python evaluate.py",
    "test:evaluate:dev": "tsx --env-file=.env.local src/scripts/test-evaluate-api.ts",
    "test:evaluate:prod": "tsx --env-file=.env.production src/scripts/test-evaluate-api.ts",
    "setup:slack": "bash scripts/setup-app.sh",
    "scenarios": "vitest run --config vitest.config.ts",
    "scenarios:watch": "vitest --config vitest.config.ts",
    "test:stripe:webhooks": "tsx --env-file=.env.local src/scripts/test-stripe-webhooks.ts",
    "test:slack:events": "tsx --env-file=.env.local src/scripts/test-slack-events.ts",
    "check:e2e": "bash scripts/e2e-check.sh",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:watch": "vitest --config vitest.unit.config.ts",
    "test:slack:interactive": "tsx --env-file=.env.local src/scripts/test-slack-interactive.ts",
    "evals:datasets": "tsx --env-file=.env.local src/evals/langwatch/datasets/push.ts",
    "evals:flagging": "tsx --env-file=.env.local src/evals/langwatch/flagging.experiment.ts",
    "evals:digest": "tsx --env-file=.env.local src/evals/langwatch/persona-digest.experiment.ts",
    "evals:rephrase": "tsx --env-file=.env.local src/evals/langwatch/rephrase.experiment.ts",
    "evals:all": "npm run evals:flagging && npm run evals:rephrase && npm run evals:style && npm run evals:digest",
    "evals:style:scaffold": "tsx --env-file=.env.local src/scripts/evaluate-style-digest.ts"
  },
  "dependencies": {
    "@mantine/core": "^8.3.12",
    "@mantine/dates": "^8.3.12",
    "@mantine/form": "^8.3.12",
    "@mantine/hooks": "^8.3.12",
    "@mantine/notifications": "^8.3.12",
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.13.0",
    "@trigger.dev/sdk": "^4.3.2",
    "@vercel/blob": "^2.0.0",
    "better-auth": "^1.4.10",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "crypto": "^1.0.1",
    "csv-parser": "^3.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.25.0",
    "gsap": "^3.14.2",
    "langwatch": "^1.12.0",
    "lenis": "^1.3.17",
    "lucide-react": "^0.562.0",
    "mongodb": "^7.0.0",
    "next": "16.1.1",
    "openai": "^6.16.0",
    "portkey-ai": "^3.0.1",
    "posthog-js": "^1.318.1",
    "posthog-node": "^5.20.0",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.3",
    "react-lite-youtube-embed": "^3.3.3",
    "resend": "^6.7.0",
    "stripe": "^20.1.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@ai-sdk/azure": "^3.0.68",
    "@eslint/eslintrc": "^3.3.3",
    "@langwatch/scenario": "^0.4.11",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@trigger.dev/build": "^4.3.2",
    "@types/node": "^25.0.6",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.1",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  }
}
