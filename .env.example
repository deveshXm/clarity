# ─────────────────────────────────────────────────────────────────────────────
# Clarity — environment variables
#
# Copy to .env.local and fill in. Vars marked REQUIRED are read at module scope:
# the app (and `npm run build`) will fail fast without them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core app ────────────────────────────────────────────────────────────────
# REQUIRED. Public base URL of this deployment. Locally this is your ngrok URL,
# not localhost — Slack has to be able to reach it.
NEXT_PUBLIC_BETTER_AUTH_URL=https://your-tunnel.ngrok-free.dev
# REQUIRED by better-auth. Any long random string.
BETTER_AUTH_SECRET=

# ── Database ────────────────────────────────────────────────────────────────
# REQUIRED. Mongo connection string + database name.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB_NAME=clarity

# ── Slack app ───────────────────────────────────────────────────────────────
# From https://api.slack.com/apps → your app → Basic Information.
SLACK_APP_ID=A0...
NEXT_PUBLIC_SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Must exactly match a redirect URL in the app manifest.
SLACK_REDIRECT_URI=https://your-tunnel.ngrok-free.dev/api/auth/slack/callback
# From the api.slack.com/apps LIST page → "Your App Configuration Tokens".
# Used by `npm run setup:slack` to push manifest updates. Single-use; rotated
# in place by the script.
SLACK_CONFIG_REFRESH_TOKEN=xoxe-...
# Optional. Pins the OAuth consent screen to one workspace (team ID, e.g.
# T08HU2MKRK2) so installs can't land on whatever workspace the browser is
# currently in. Leave UNSET in production — it breaks multi-tenant installs.
SLACK_PINNED_TEAM_ID=

# ── LLM (message analysis + style digests) ──────────────────────────────────
# REQUIRED for any coaching to work. Portkey routes to Azure OpenAI.
PORTKEY_AI_KEY=

# ── Billing (Stripe) ────────────────────────────────────────────────────────
# REQUIRED — read at module scope by the /api/stripe/* routes.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Set to "true" to bypass usage quotas while testing. MUST be unset/false for
# any meaningful quota or payment test.
DISABLE_QUOTA=

# ── Analytics (optional) ────────────────────────────────────────────────────
# Omit entirely and analytics becomes a no-op — nothing breaks.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Set to "true" to also send events from local dev.
POSTHOG_DEBUG=

# ── Simulated teammates (optional, dev-only dogfooding) ─────────────────────
# AliceBot (/api/demo) and BobBot (/api/demo2) are separate Slack apps that
# reply in-channel so you have a live-feeling conversation to coach against.
# Without these, both routes simply no-op.
DEMO_SLACK_BOT_TOKEN=
DEMO_SLACK_SIGNING_SECRET=
DEMO2_SLACK_BOT_TOKEN=
DEMO2_SLACK_SIGNING_SECRET=
# Azure creds used *only* by the companion bots (the main app goes via Portkey).
AZURE_API_ENDPOINT=
AZURE_API_KEY=
AZURE_API_VERSION=2024-12-01-preview
AZURE_DEPLOYMENT_NAME=gpt-5-mini
AZURE_MODEL_NAME=

# ── Eval platform (LangWatch) ────────────────────────────────────────────────
# Every eval suite is a LangWatch experiment and the scenario suite reports
# there too. Get the key with `langwatch login` (choose "Project, SDK API key")
# or from Settings → API keys in the LangWatch app. See QUALITY.md.
LANGWATCH_API_KEY=

# ── Evals / test scripts (optional) ─────────────────────────────────────────
BASE_URL=http://localhost:3000
TEST_BASE_URL=http://localhost:3000
SCENARIO_MODEL=
SIM_CONCURRENCY=4
SIM_MIN_ACCURACY=0.9
DIGEST_TEST_SLACK_ID=
DIGEST_TEST_TEAM_ID=
